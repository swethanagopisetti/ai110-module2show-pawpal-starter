classDiagram
    class Task {
        +str description
        +time time
        +str frequency
        +bool completed
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~Task~ tasks
    }

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +get_all_tasks(owner) list~Task~
        +organize_tasks(owner) list~Task~
        +mark_task_complete(task)
    }

    Owner "1" *-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : tracks
    Scheduler ..> Owner : retrieves tasks through
    Scheduler ..> Task : organizes and updates
